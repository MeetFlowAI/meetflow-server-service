{
  "name": "meetflow-server-service",
  "version": "2.0.0",
  "description": "MeetFlow backend service — AI-powered meeting platform. Multi-tenant SaaS architecture with schema-per-org PostgreSQL isolation.",
  "author": "Adesh",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "main": "index.js",
  "scripts": {
    "dev":      "nodemon index.js",
    "start":    "node index.js",
    "lint":     "eslint src --ext .js --report-unused-disable-directives --max-warnings 0",
    "test":     "vitest",
    "coverage": "vitest run --coverage",
    "migrate":  "node src/scripts/migrate.js",
    "seed":     "node src/scripts/seed.js",
    "generate-migration": "node src/scripts/generate-migration.js"
  },
  "dependencies": {
    "express":              "^5.0.1",
    "dotenv":               "^16.4.5",

    "zod":                  "^3.23.8",

    "pino":                 "^9.1.0",
    "pino-pretty":          "^11.0.0",
    "uuid":                 "^9.0.1",

    "helmet":               "^7.1.0",
    "cors":                 "^2.8.5",
    "express-rate-limit":   "^7.2.0",

    "jsonwebtoken":         "^9.0.2",
    "bcrypt":               "^5.1.1",

    "sequelize":            "^6.37.3",
    "pg":                   "^8.11.5",
    "pg-hstore":            "^2.3.4",

    "nodemailer":           "^6.9.13",

    "multer":               "^1.4.5-lts.1",
    "fluent-ffmpeg":        "^2.1.3",
    "form-data":            "^4.0.0",
    "yaml":                 "^2.4.5",

    "axios":                "^1.6.8",
    "livekit-server-sdk":   "^2.6.0",
    "stream-chat":          "^8.40.1",
    "@supabase/supabase-js":"^2.43.5",
    "swagger-ui-express":   "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "eslint":  "^8.57.0",
    "vitest":  "^1.6.0"
  }
}
