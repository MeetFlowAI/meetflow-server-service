# ════════════════════════════════════════════════════════════════════════
# MeetFlow Server Service — Environment Variables
# ════════════════════════════════════════════════════════════════════════
# Copy this file to .env.development and fill in all values.
# Never commit a .env.* file. Only .env.example is tracked by git.
#
# Required values are marked [REQUIRED].
# Optional values with defaults are marked [OPTIONAL — default: value].
# ════════════════════════════════════════════════════════════════════════


# ── Server ───────────────────────────────────────────────────────────────
# [REQUIRED] Runtime environment. One of: development | staging | production | test
NODE_ENV=development

# [OPTIONAL — default: 8000] Port the server listens on
PORT=8000


# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# [REQUIRED] Full connection string. Takes priority over individual vars below.
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/meetflow_db

# [OPTIONAL] Individual connection params (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meetflow_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_SSL=false


# ── Authentication ────────────────────────────────────────────────────────
# [REQUIRED] JWT signing secret for access tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_hex_secret

# [REQUIRED] JWT signing secret for refresh tokens (must differ from access secret).
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_REFRESH_SECRET=replace_with_different_64_byte_hex_secret


# ── System owner / host credentials ──────────────────────────────────────
# [REQUIRED] Master super-admin seeded on first run. Change immediately after setup.
HOST_FIRST_NAME=Admin
HOST_LAST_NAME=User
HOST_EMAIL=admin@meetflow.io
HOST_PASSWORD=ChangeThisImmediately@123
HOST_ROLE=master_super_admin


# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# [REQUIRED for invitation/reset flows] Gmail account used for transactional email.
# Enable "App Passwords" in Google account security settings.
MAIL_FROM=notifications@yourdomain.com
MAIL_PASSWORD=your_gmail_app_password


# ── Service URLs ──────────────────────────────────────────────────────────
# [REQUIRED] Public webhook URL for this service (used by LiveKit + AI service callbacks)
# In development: use ngrok → https://your-tunnel.ngrok.io/api/v1/webhook
WEBHOOK_URL=https://your-domain.com/api/v1/webhook

# [REQUIRED] Frontend origin for CORS whitelist
FRONTEND_URL_PROD=https://app.meetflow.io
FRONTEND_URL_LOCAL=http://localhost:5173

# [OPTIONAL] Internal service URL (set automatically in Docker Compose)
BACKEND_SERVICE_URL=http://localhost:8000


# ── LiveKit ───────────────────────────────────────────────────────────────
# [REQUIRED] LiveKit server credentials. Get from: https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret


# ── Stream Chat ───────────────────────────────────────────────────────────
# [REQUIRED] Stream Chat credentials. Get from: https://getstream.io/dashboard/
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret


# ── AI Service ────────────────────────────────────────────────────────────
# [REQUIRED] Internal AI service base URL
AI_SERVICE_URL=http://localhost:8001

# [REQUIRED] Shared secret for AI service internal calls
AI_INTERNAL_KEY=replace_with_strong_internal_secret

# [REQUIRED] HMAC secret used by AI service to sign webhook callbacks
# Must match the value configured in the AI service
AI_WEBHOOK_SECRET=replace_with_strong_webhook_hmac_secret


# ── Supabase / Storage ────────────────────────────────────────────────────
# [REQUIRED for recording upload] Supabase project credentials.
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# [REQUIRED for recording upload] Supabase S3-compatible storage
SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key
SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_key
SUPABASE_S3_REGION=ap-south-1
SUPABASE_STORAGE_BUCKET=meetflow-recordings
